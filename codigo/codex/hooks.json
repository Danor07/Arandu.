{
  "description": "MSP: reenvia los eventos de Codex a `msp --hook --plataforma codex`. Copiar a ~/.codex/hooks.json o a .codex/hooks.json del proyecto, con msp en el PATH.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "msp --hook --plataforma codex", "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "msp --hook --plataforma codex", "timeout": 3 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "msp --hook --plataforma codex", "timeout": 30, "statusMessage": "msp: revisando antecedentes" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "msp --hook --plataforma codex", "timeout": 60 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "msp --hook --plataforma codex", "timeout": 30 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "msp --hook --plataforma codex", "timeout": 30 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "msp --hook --plataforma codex", "timeout": 30 } ] }
    ]
  }
}
